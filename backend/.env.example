# ══════════════════════════════════════════════════════════════════════════════
# Digital Marketing AI Platform - Backend Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_marketing
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ─── Redis (for Bull queues) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or use a full Redis URL:
# REDIS_URL=redis://user:password@host:port

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ─── Token Encryption (must be exactly 32 characters) ────────────────────────
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=change-this-32-char-encryption-key-here

# ─── Meta (Facebook) Ads ─────────────────────────────────────────────────────
# Create app at: https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3001/api/accounts/meta/callback
META_API_VERSION=v19.0

# ─── Google Ads ───────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/accounts/google/callback
# Apply for developer token at: https://ads.google.com/home/tools/manager-accounts/
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_MANAGER_ID=your_mcc_manager_id

# ─── TikTok Ads ───────────────────────────────────────────────────────────────
# Create app at: https://ads.tiktok.com/marketing_api/
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_REDIRECT_URI=http://localhost:3001/api/accounts/tiktok/callback

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your_openai_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000

# ─── ElevenLabs (Voiceover) ───────────────────────────────────────────────────
# Get key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Runway ML (Video Generation) ────────────────────────────────────────────
# Get key at: https://runwayml.com/
RUNWAY_API_KEY=your_runway_api_key

# ─── n8n Workflows ────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_VIDEO_PIPELINE_WEBHOOK=http://localhost:5678/webhook/video-pipeline
N8N_TREND_ANALYSIS_WEBHOOK=http://localhost:5678/webhook/trend-analysis
N8N_AD_COPY_WEBHOOK=http://localhost:5678/webhook/ad-copy

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
