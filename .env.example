# ══════════════════════════════════════════════════════════════════════════════
# Digital Marketing AI Platform - Root Environment Variables
# Copy to .env and configure before running docker-compose up
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=digital_marketing
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Backend ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=generate_this_with_openssl_rand_base64_64
JWT_EXPIRES_IN=7d
# Generate: openssl rand -base64 64
JWT_REFRESH_SECRET=generate_another_with_openssl_rand_base64_64
JWT_REFRESH_EXPIRES_IN=30d
# Must be exactly 32 characters
ENCRYPTION_KEY=exactly-32-chars-encryption-key!

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ─── Meta (Facebook) Ads ─────────────────────────────────────────────────────
# https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/accounts/meta/callback

# ─── Google Ads ───────────────────────────────────────────────────────────────
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/accounts/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ID=

# ─── TikTok Ads ───────────────────────────────────────────────────────────────
# https://ads.tiktok.com/marketing_api/
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/accounts/tiktok/callback

# ─── AI Services ──────────────────────────────────────────────────────────────
# https://platform.openai.com/
OPENAI_API_KEY=sk-...

# https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# https://runwayml.com/
RUNWAY_API_KEY=

# ─── n8n Workflow Automation ──────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_API_KEY=
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# ─── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
